flowchart LR
  subgraph INGEST["1 - Ingest"]
    URL["Page URL"] ==> READER["Jina Reader API<br/>X-Return-Format: html"]
    READER ==> HTML["Source HTML<br/>kept verbatim"]
  end

  subgraph SEGMENT["2 - Segment, with offsets"]
    HTML ==> WALK["HTML parser walks visible text<br/>skips script / style / nav / pre"]
    WALK ==> SENT["Sentences + start,end offsets<br/>into the ORIGINAL html"]
    SENT ==> CHUNK["Chunks of g sentences<br/>g = granularity"]
  end

  subgraph RANK["3 - One listwise call"]
    CHUNK ==> PROMPT["Query + ALL chunks<br/>packed in a single context"]
    PROMPT ==> MODEL["jina-reranker-v3.5-mlx<br/>0.6B, LBNL, 3L2G hybrid attention"]
    MODEL ==> SCORES["Ranked chunks<br/>cosine on 512-d projections"]
  end

  subgraph RENDER["4 - Highlight in place"]
    SCORES ==> MAP["Map ranks back through<br/>the recorded offsets"]
    MAP ==> MERGE["Merge touching spans<br/>break on headings"]
    MERGE ==> OUT["Original HTML + mark tags"]
  end

  HTML -.->|"same string, never re-rendered"| MAP

  classDef ingest fill:#e3f2fd,stroke:#1565c0,color:#0d47a1
  classDef seg fill:#f3e5f5,stroke:#6a1b9a,color:#4a148c
  classDef rank fill:#fff8e1,stroke:#f9a825,color:#e65100
  classDef render fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20
  class URL,READER,HTML ingest
  class WALK,SENT,CHUNK seg
  class PROMPT,MODEL,SCORES rank
  class MAP,MERGE,OUT render
